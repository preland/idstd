// Reads IDSTD_CHECK_VAR, which the caller is expected to export as exactly
// "idstd_check_probe" (17 bytes), and confirms env_has and env_get agree.

check_env() {
  int has_i = env_has("IDSTD_CHECK_VAR");
  int n = check_env_get_len();
  int ok = check_env_report(has_i, n);
} return int ok;

check_env_get_len() {
  int[] buf = make_buf(256);
  int n = env_get("IDSTD_CHECK_VAR", buf, 256);
} return int n;

check_env_report(int has_i, int n) {
  int ok = 0;
  if (has_i == 1 && n == 17) {
    ok = 1;
    print("PASS env: IDSTD_CHECK_VAR set, env_get needs " + n + " bytes");
  } else {
    print("FAIL env: has=" + has_i + " n=" + n + " (run with IDSTD_CHECK_VAR=idstd_check_probe set)");
  }
} return int ok;
