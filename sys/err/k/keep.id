// The diagnostics, kept for something to show them.
//
// Bounded at sixteen, and it keeps the **first** sixteen rather than the last.
// That is the interesting choice here: a parser that loses its place produces a
// cascade, and in a cascade the first message is the cause and the rest are the
// wreckage. A ring that overwrote would show a person sixteen consequences of a
// problem it had already discarded.
//
// Three parallel lists rather than one formatted string per entry, because a
// consumer needs the *file* to open it and the *line* to scroll to, and
// re-parsing a message to get them back is how a UI ends up depending on the
// wording of an error.
//
// Lifted from idem/engine/core/util/err/k/keep.id.

err_keep_init() {
  export string[] err_fs = [];
  export int[] err_ls = [];
  err_keep_init2();
} return void;

// A second function because a block holds three actions and two of them are
// already exports -- which is why every init chain in this language is a chain.
err_keep_init2() {
  export string[] err_ms = [];
} return void;

err_keep(string path, int ln, string msg) {
  if (len((import err_ms)) < 16) {
    push((import err_fs), path);
    err_keep2(ln, msg);
  }
} return void;
