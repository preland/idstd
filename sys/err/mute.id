// Muting diagnostics, for a program whose stdout is data.
//
// Lifted from idem/engine/core/util/err/mute.id.

// q is 1 to silence err_say, 0 to let it through. The count still rises, so a
// muted program still reports failure through its exit code.
err_mute(int idstd_q) {
  lset((import err_n), 1, idstd_q);
} return void;
given err_init (1):() then idstd_err_t_mute:(1)
given err_init (0):() then idstd_err_t_mute:(0)

// The only place in this module that prints. Everything routes through it so
// that one flag can turn the whole module quiet.
err_say(string idstd_msg) {
  if ((import err_n)[1] = 0) {
    print(idstd_msg);
  }
} return void;
given err_init ("hello"):() then prints:("hello\n")
given idstd_err_t_one ("hello"):() then prints:("")

// Test check (internal): the mute flag read back, for err_mute's own cases.
idstd_err_t_mute() {
  int idstd_ret_i = (import err_n)[1];
} return int idstd_ret_i;
given err_init ():(0)
given idstd_err_t_one ():(1)
