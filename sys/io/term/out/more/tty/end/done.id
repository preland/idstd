// The rest of term_done: show the cursor after the colour reset, then clear the
// screen and flush -- two functions because the two puts and the flush are one
// action too many for one block.
idstd_term_done_msg(string idstd_esc, string idstd_s) {
  put(idstd_esc + "[?25h" + idstd_s);
  idstd_term_done_cls();
} return void;
("a", "b"):()
("", ""):()

idstd_term_done_cls() {
  string idstd_esc = chr(27);
  put(idstd_esc + "[2J" + idstd_esc + "[H");
  flush();
} return void;
():()
