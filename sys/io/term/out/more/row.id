// Row y as one string: each cell's character, each preceded by an escape only
// where idstd_term_attr_new says the colour changes.
idstd_term_row(int idstd_y) {
  string idstd_s = "";
  int idstd_x = 0;
  while(idstd_x < (import term_w)) {
    idstd_s = idstd_s + idstd_term_cell(idstd_y, idstd_x);
    idstd_x = idstd_x + 1;
  }
} return string idstd_s;
given idstd_term_t_setup (0):("\033[0m    ")
given idstd_term_t_mark (0):("\033[32mA\033[0m   ")

idstd_term_cell(int idstd_y, int idstd_x) {
  int idstd_i = idstd_y * (import term_w) + idstd_x;
  string idstd_s = idstd_term_sgr_at(idstd_x, idstd_i) + chr((import term_scr)[idstd_i]);
} return string idstd_s;
given idstd_term_t_setup (0, 1):(" ")
given idstd_term_t_mark (1, 2):(" ")

idstd_term_sgr_at(int idstd_x, int idstd_i) {
  string idstd_s = "";
  if(idstd_term_attr_new(idstd_x, idstd_i)) {
    idstd_s = term_sgr((import term_attr)[idstd_i]);
  }
} return string idstd_s;
given idstd_term_t_setup (1, 5):("")
given idstd_term_t_mark (1, 1):("\033[0m")
