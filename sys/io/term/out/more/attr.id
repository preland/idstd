// Whether cell i needs its own SGR escape: always at the start of a row (which
// also re-establishes the colour per row), otherwise only when its attribute
// differs from the cell to its left -- so a colour change costs an escape, not
// every cell.
idstd_term_attr_new(int idstd_x, int idstd_i) {
  int idstd_hit = 1;
  if(idstd_x > 0) {
    idstd_hit = idstd_term_attr_diff(idstd_i);
  }
} return int idstd_hit;
given idstd_term_t_setup (0, 0):(1)
given idstd_term_t_setup (1, 1):(0)

idstd_term_attr_diff(int idstd_i) {
  int idstd_hit = 0;
  if((import term_attr)[idstd_i] != (import term_attr)[idstd_i - 1]) {
    idstd_hit = 1;
  }
} return int idstd_hit;
given idstd_term_t_mark (1):(1)
given idstd_term_t_setup (1):(0)
