// The character-cell screen: term_w x term_h cells, row-major, as two parallel
// lists -- term_scr the byte code in each cell, term_attr its colour attribute
// (an index into term_pal). Both start blank: a space, attribute 0.
//
// Split from term_init to stay inside the action limit.
term_scr_init(int w, int h) {
  export int term_w = w;
  export int term_h = h;
  term_scr_alloc(w * h);
} return void;
