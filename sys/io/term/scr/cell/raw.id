idstd_term_put(int idstd_x, int idstd_y, int idstd_c, int idstd_attr) {
  int idstd_m = idstd_term_idx(idstd_x, idstd_y);
  lset((import term_scr), idstd_m, idstd_c);
  idstd_term_put_attr(idstd_x, idstd_y, idstd_attr);
} return void;
