// idstd_term_put already spends its three actions on the character, so the attribute
// is a tail call.
idstd_term_put_attr(int idstd_x, int idstd_y, int idstd_attr) {
  int idstd_m = idstd_term_idx(idstd_x, idstd_y);
  lset((import term_attr), idstd_m, idstd_attr);
} return void;
