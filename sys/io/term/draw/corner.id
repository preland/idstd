// The four '+' corners, two per function to stay inside the action limit.
idstd_term_box_corners(int idstd_x, int idstd_y, int idstd_w, int idstd_h, int idstd_attr) {
  term_set(idstd_x, idstd_y, 43, idstd_attr);
  term_set(idstd_x + idstd_w - 1, idstd_y, 43, idstd_attr);
  idstd_term_box_corners2(idstd_x, idstd_y, idstd_w, idstd_h, idstd_attr);
} return void;
given idstd_term_t_setup (0, 0, 4, 3, 1):() then idstd_term_t_asum:(4)
given idstd_term_t_setup (0, 0, 4, 3, 1):() then idstd_term_t_sum:(428)

idstd_term_box_corners2(int idstd_x, int idstd_y, int idstd_w, int idstd_h, int idstd_attr) {
  term_set(idstd_x, idstd_y + idstd_h - 1, 43, idstd_attr);
  term_set(idstd_x + idstd_w - 1, idstd_y + idstd_h - 1, 43, idstd_attr);
} return void;
given idstd_term_t_setup (0, 0, 4, 3, 1):() then idstd_term_t_asum:(2)
given idstd_term_t_setup (0, 0, 4, 3, 1):() then idstd_term_t_sum:(406)
