// A rectangular border in '-' (45), '|' (124) and '+' (43), which render on
// any terminal: the edges first, then the corners over their ends.
term_box(int x, int y, int w, int h, int attr) {
  term_box_edges(x, y, w, h, attr);
  term_box_corners(x, y, w, h, attr);
} return void;
given term_t_setup (0, 0, 4, 3, 1):() then term_t_asum:(10)
given term_t_setup (0, 0, 4, 3, 1):() then term_t_sum:(664)

term_box_edges(int x, int y, int w, int h, int attr) {
  term_hline(x + 1, y, w - 2, 45, attr);
  term_hline(x + 1, y + h - 1, w - 2, 45, attr);
  term_box_vedges(x, y, w, h, attr);
} return void;
given term_t_setup (0, 0, 4, 3, 1):() then term_t_asum:(6)
given term_t_setup (0, 0, 4, 3, 1):() then term_t_sum:(620)

term_box_vedges(int x, int y, int w, int h, int attr) {
  term_vline(x, y + 1, h - 2, 124, attr);
  term_vline(x + w - 1, y + 1, h - 2, 124, attr);
} return void;
given term_t_setup (0, 0, 4, 3, 2):() then term_t_asum:(4)
given term_t_setup (0, 0, 4, 3, 1):() then term_t_sum:(568)
