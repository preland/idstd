// Bytes across the child's stdout, stderr and stdin, one byte per cell. See
// proc.h.

native proc_read(int handle, int[] buf, int n, int timeout_ms) return int;

native proc_read_err(int handle, int[] buf, int n, int timeout_ms) return int;

native proc_write(int handle, int[] buf, int n, int timeout_ms) return int;
