// One coordinate of corner cix pushed onto xs. Three functions because they
// call three different corner functions, which is what makes them three.
idstd_d3_cube_px(int[] idstd_xs, int idstd_half, int idstd_cix) {
  int idstd_m = d3_cube_x(idstd_cix, idstd_half);
  push(idstd_xs, idstd_m);
} return void;
([], 4, 1):([4])
([8], 4, 0):([8, -4])

idstd_d3_cube_py(int[] idstd_xs, int idstd_half, int idstd_cix) {
  int idstd_m = d3_cube_y(idstd_cix, idstd_half);
  push(idstd_xs, idstd_m);
} return void;
([], 4, 2):([4])
([1], 3, 1):([1, -3])

idstd_d3_cube_pz(int[] idstd_xs, int idstd_half, int idstd_cix) {
  int idstd_m = d3_cube_z(idstd_cix, idstd_half);
  push(idstd_xs, idstd_m);
} return void;
([], 4, 4):([4])
([1], 3, 3):([1, -3])
