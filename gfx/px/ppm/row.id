// One row of the dump, left to right.
idstd_ppm_l_row(int idstd_y) {
  int idstd_x = 0;
  while(idstd_x < (import sf_l_w)) {
    idstd_ppm_l_px(idstd_x, idstd_y);
    idstd_x = idstd_x + 1;
  }
} return void;
given idstd_sf_l_t_setup (0):() then idstd_sf_l_t_len:(64)
given idstd_sf_l_t_setup (7):() then idstd_sf_l_t_sum:(0)

// One pixel as "r g b" in decimal, by division and remainder, exactly as both
// copies wrote it.
idstd_ppm_l_px(int idstd_x, int idstd_y) {
  int idstd_cv = (import sf_l_px)[sf_l_idx(idstd_x, idstd_y)];
  print((idstd_cv / 65536) + " " + (idstd_cv / 256 % 256) + " " + (idstd_cv % 256));
} return void;
given idstd_sf_l_t_setup (0, 0):() then idstd_sf_l_t_sum:(0)
given idstd_sf_l_t_setup (7, 7):() then idstd_sf_l_t_len:(64)
