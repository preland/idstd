// One pixel as "r g b" in decimal, by division and remainder, exactly as both
// copies wrote it.
ppm_l_px(int x, int y) {
  int cv = (import sf_l_px)[sf_l_idx(x, y)];
  print((cv / 65536) + " " + (cv / 256 % 256) + " " + (cv % 256));
} return void;
