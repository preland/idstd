// The index of pixel (x, y) in sf_l_px. Unclipped on purpose: sf_l_pset is the
// one place bounds are tested.
sf_l_idx(int idstd_x, int idstd_y) {
  int idstd_m = idstd_y * (import sf_l_w) + idstd_x;
} return int idstd_m;
