// One pixel, dropped when (x, y) is off the surface. The clip is not optional:
// an out-of-range list store aborts the process rather than being ignored. lset
// because an imported list cannot be assigned through directly.
sf_l_pset(int x, int y, int cv) {
  if(x >= 0 && x < (import sf_l_w) && y >= 0 && y < (import sf_l_h)) {
    int m = sf_l_idx(x, y);
    lset((import sf_l_px), m, cv);
  }
} return void;
