// gfx/px list surface -- a framebuffer that is one int[] of packed 0xRRGGBB,
// row-major, top row first.
//
// demos/gfxdemo, idml's id backend and id_nativeapp each carried this surface,
// the last two vendored from the first. It is the simplest one there is:
// sf_l_px is a plain list, so a backend's present call can take it whole.
// idem's sf_ surface lives in the flat store with spans and a clip rectangle,
// and shares none of these names.
//
// sf_l_init exports all three globals, so it runs before anything else in
// gfx/ that draws.
sf_l_init(int idstd_w, int idstd_h) {
  export int sf_l_w = idstd_w;
  export int sf_l_h = idstd_h;
  idstd_sf_l_alloc(idstd_w * idstd_h);
} return void;
(4, 3):() then idstd_sf_l_t_len:(12)
(2, 5):() then idstd_sf_l_t_len:(10)

// A fresh, all-black pixel list of n entries -- split from sf_l_init only to
// stay inside the action limit.
idstd_sf_l_alloc(int idstd_n) {
  export int[] sf_l_px = [];
  idstd_sf_l_fill(idstd_n);
} return void;
(6):() then idstd_sf_l_t_len:(6)
(0):() then idstd_sf_l_t_len:(0)

// Appends n black pixels. A loop of push rather than a literal, because n is
// only known at run time.
idstd_sf_l_fill(int idstd_n) {
  int idstd_i = 0;
  while(idstd_i < idstd_n) {
    push((import sf_l_px), 0);
    idstd_i = idstd_i + 1;
  }
} return void;
