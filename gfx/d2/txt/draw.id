// A string left to right from (x, y), 8 * mag pixels per character.
txt_g8_draw(int x, int y, string s, int cv, int mag) {
  int i = 0;
  while(i < len(s)) {
    int c = charat(s, i);
    txt_g8_glyph(x + i * 8 * mag, y, c, cv, mag);
    i = i + 1;
  }
} return void;
