// A string left to right from (x, y), 8 * mag pixels per character.
txt_g8_draw(int idstd_x, int idstd_y, string idstd_s, int idstd_cv, int idstd_mag) {
  int idstd_i = 0;
  while(idstd_i < len(idstd_s)) {
