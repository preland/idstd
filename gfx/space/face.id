// The corner each of the 36 vertex slots uses: 6 faces x 2 triangles x 3
// corners. One function where every copy had two (face_table and face_corner),
// because nothing read the table except this lookup; the list is still built
// on each call, exactly as before.
d3_cube_corner(int idstd_i) {
  int[] idstd_xs = [0,1,3, 0,3,2, 4,6,7, 4,7,5, 0,2,6, 0,6,4,
              1,5,7, 1,7,3, 0,4,5, 0,5,1, 2,3,7, 2,7,6];
  int idstd_m = idstd_xs[idstd_i];
} return int idstd_m;
(0):(0)
(35):(6)
