// The colour list's remaining slots from i.
idstd_d3_cube_cfill(int[] idstd_xs, int idstd_cv, int idstd_i) {
  while (idstd_i < 36) {
    push(idstd_xs, idstd_cv);
    idstd_i = idstd_i + 1;
  }
} return void;
