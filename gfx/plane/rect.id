// A filled rectangle on the list surface. Clipping is sf_l_pset's, pixel by
// pixel, so a rectangle may hang off any edge. Carried by idml's backend and
// id_nativeapp.
d2_l_rect(int idstd_x, int idstd_y, int idstd_w, int idstd_h, int idstd_cv) {
  int idstd_j = 0;
  while(idstd_j < idstd_h) {
    idstd_d2_l_row(idstd_x, idstd_y + idstd_j, idstd_w, idstd_cv);
    idstd_j = idstd_j + 1;
  }
} return void;
given idstd_sf_l_t_setup (0, 0, 2, 2, 1):() then idstd_sf_l_t_sum:(4)
given idstd_sf_l_t_setup (6, 7, 4, 4, 1):() then idstd_sf_l_t_sum:(2)

// One row of it.
idstd_d2_l_row(int idstd_x, int idstd_y, int idstd_w, int idstd_cv) {
  int idstd_i = 0;
  while(idstd_i < idstd_w) {
    sf_l_pset(idstd_x + idstd_i, idstd_y, idstd_cv);
    idstd_i = idstd_i + 1;
  }
} return void;
given idstd_sf_l_t_setup (0, 1, 3, 2):() then idstd_sf_l_t_sum:(6)
given idstd_sf_l_t_setup (5, 0, 5, 1):() then idstd_sf_l_t_sum:(3)
