// gfx/plane 8x8 text -- the fixed 8x8 bitmap face idml's backend and id_nativeapp
// drew their labels with, magnified by a whole number. idem's txt_ is a
// different face (8x16) with its own names.
//
// One row of one glyph as a mask, bit 128 leftmost. A code outside printable
// ASCII reads as a space rather than past the table, because an out-of-range
// list read aborts the process. Needs txt_g8_init.
idstd_txt_g8_row(int idstd_c, int idstd_j) {
  int idstd_m = idstd_c;
  if(idstd_c < 32 || idstd_c > 126) {
    idstd_m = 32;
  }
  int idstd_v = (import txt_g8)[(idstd_m - 32) * 8 + idstd_j];
} return int idstd_v;
given txt_g8_init (33, 1):(60)
given txt_g8_init (7, 0):(0)

// One glyph at (x, y), each lit font pixel a mag x mag block. The row loop and
// the column loop are two functions because a loop in an if in a loop nests
// deeper than a block may.
txt_g8_glyph(int idstd_x, int idstd_y, int idstd_c, int idstd_cv, int idstd_mag) {
  int idstd_j = 0;
  while(idstd_j < 8) {
    int idstd_bits = idstd_txt_g8_row(idstd_c, idstd_j);
    idstd_txt_g8_bits(idstd_x, idstd_y + idstd_j * idstd_mag, idstd_bits, idstd_cv, idstd_mag);
    idstd_j = idstd_j + 1;
  }
} return void;
given idstd_sf_l_t_setup (0, 0, 33, 1, 1):() then idstd_sf_l_t_sum:(16)
given idstd_sf_l_t_setup (0, 0, 32, 1, 1):() then idstd_sf_l_t_sum:(0)

// One glyph row: each of the mask's eight bits, from 128 down, tested by
// division as both copies wrote it.
idstd_txt_g8_bits(int idstd_x, int idstd_y, int idstd_bits, int idstd_cv, int idstd_mag) {
  int idstd_i = 0;
  int idstd_bit = 128;
  while(idstd_i < 8) {
    if((idstd_bits / idstd_bit) % 2 == 1) {
      d2_l_rect(idstd_x + idstd_i * idstd_mag, idstd_y, idstd_mag, idstd_mag, idstd_cv);
    }
    idstd_i = idstd_i + 1;
    idstd_bit = idstd_bit / 2;
  }
} return void;
given idstd_sf_l_t_setup (0, 0, 129, 1, 1):() then idstd_sf_l_t_sum:(2)
given idstd_sf_l_t_setup (0, 0, 255, 2, 1):() then idstd_sf_l_t_sum:(16)
