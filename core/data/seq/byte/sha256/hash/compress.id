// Running all 64 rounds over one block's schedule, adding the result back
// into the running hash, and the block loop that drives both.

// The two cases are the single-block real vectors for "" and "abc": the
// standard initial hash words in, the block's own message schedule (each
// cross-checked against `sha256sum`, see the workspace report), and the
// working state after 64 rounds, before it is added back.
idstd_sha256_compress(int[] idstd_wst, int[] idstd_sch, int[] idstd_rc) {
  int idstd_i = 0;
  while (idstd_i < 64) {
    idstd_sha256_round(idstd_wst, idstd_sch, idstd_rc, idstd_i);
    idstd_i = idstd_i + 1;
  }
} return void;
