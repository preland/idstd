// One block: its own working state, its own message schedule, 64 rounds,
// folded back.
idstd_sha256_block(int[] idstd_hst, int[] idstd_buf, int[] idstd_rc, int idstd_at) {
  int[] idstd_sch = idstd_sha256_sched(idstd_buf, idstd_at);
  int[] idstd_wst = lst_copy(idstd_hst);
  idstd_sha256_compress(idstd_wst, idstd_sch, idstd_rc);
} chain (int[] idstd_hst, int[] idstd_buf, int[] idstd_rc, int idstd_at) {
  idstd_sha256_addback(idstd_hst, idstd_wst);
} return void;
