// The block's compressed state folded back into the running hash (FIPS
// 180-4 section 6.2.2, step 4): eight adds, split the same way the shift
// above was.
idstd_sha256_addback(int[] idstd_hst, int[] idstd_wst) {
  idstd_hst[0] = idstd_hst[0] + idstd_wst[0];
  idstd_hst[1] = idstd_hst[1] + idstd_wst[1];
  idstd_hst[2] = idstd_hst[2] + idstd_wst[2];
} chain (int[] idstd_hst, int[] idstd_wst) {
  idstd_hst[3] = idstd_hst[3] + idstd_wst[3];
  idstd_hst[4] = idstd_hst[4] + idstd_wst[4];
  idstd_hst[5] = idstd_hst[5] + idstd_wst[5];
} chain (int[] idstd_hst, int[] idstd_wst) {
  idstd_hst[6] = idstd_hst[6] + idstd_wst[6];
  idstd_hst[7] = idstd_hst[7] + idstd_wst[7];
} return void;
