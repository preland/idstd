// Ch(x, y, z): where x's bit is 1, take y's bit; where it is 0, take z's.
idstd_sha256_ch(int idstd_x, int idstd_y, int idstd_z) {
  int idstd_v = (idstd_x & idstd_y) ^ ((~idstd_x) & idstd_z);
} return int idstd_v;
(12, 10, 6):(10)
