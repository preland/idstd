// Maj(x, y, z): each output bit is whichever value two of the three inputs
// agree on.
idstd_sha256_maj(int idstd_x, int idstd_y, int idstd_z) {
  int idstd_v = ((idstd_x & idstd_y) ^ (idstd_x & idstd_z)) ^ (idstd_y & idstd_z);
} return int idstd_v;
