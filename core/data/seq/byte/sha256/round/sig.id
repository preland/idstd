idstd_sha256_bsig1(int idstd_x) {
  int idstd_v = (idstd_sha256_rotr(idstd_x, 6) ^ idstd_sha256_rotr(idstd_x, 11)) ^ idstd_sha256_rotr(idstd_x, 25);
} return int idstd_v;
