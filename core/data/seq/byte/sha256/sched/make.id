// The other forty-eight words, one call per index into idstd_sha256_sch_ext.
idstd_sha256_sch64(int[] idstd_sch) {
  int idstd_i = 16;
  while (idstd_i < 64) {
    idstd_sha256_sch_ext(idstd_sch, idstd_i);
    idstd_i = idstd_i + 1;
  }
} return void;
