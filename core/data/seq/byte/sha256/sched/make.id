// Building one block's 64-word message schedule (FIPS 180-4 section 6.2.2,
// step 1): the block's own sixteen big-endian words, then forty-eight more
// built from them by idstd_sha256_sch_ext.

// idstd_buf is the whole padded message; idstd_at is where this block starts.
// The first half is a loop over idstd_sha256_sch16, the second is one call
// into idstd_sha256_sch64 -- two actions, well inside budget, so this needed
// no second chain.
idstd_sha256_sched(int[] idstd_buf, int idstd_at) {
  int[] idstd_sch = [];
  int idstd_i = 0;
  while (idstd_i < 16) {
    idstd_sha256_sch16(idstd_sch, idstd_buf, idstd_at, idstd_i);
    idstd_i = idstd_i + 1;
  }
} chain (int[] idstd_buf, int idstd_at) {
  idstd_sha256_sch64(idstd_sch);
} return int[] idstd_sch;
