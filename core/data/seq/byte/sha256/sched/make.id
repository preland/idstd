// One 32-bit big-endian word at byte offset idstd_at + idstd_i*4, appended.
// Indexing is not a call, so the whole four-byte assembly is one statement --
// wider but the same shape as the comparisons idstd_lst's neighbours use.
idstd_sha256_sch16(int[] idstd_sch, int[] idstd_buf, int idstd_at, int idstd_i) {
  int idstd_p = idstd_at + idstd_i * 4;
  int idstd_v = ((idstd_buf[idstd_p] << 24) | (idstd_buf[idstd_p + 1] << 16)) | ((idstd_buf[idstd_p + 2] << 8) | idstd_buf[idstd_p + 3]);
  push(idstd_sch, idstd_v);
} return void;
