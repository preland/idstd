idstd_sha256_s1(int idstd_x) {
  word idstd_wx = idstd_x;
  idstd_wx = idstd_wx & 4294967295;
  word idstd_wv = ushr(idstd_wx, 10);
} chain (int idstd_x) {
  int idstd_u = idstd_wv;
  int idstd_v = (idstd_sha256_rotr(idstd_x, 17) ^ idstd_sha256_rotr(idstd_x, 19)) ^ idstd_u;
} return int idstd_v;
