// The three optional gzip header fields idstd_gz_offset delegates to: the
// two that need their own reader because a fixed two-byte skip is not
// enough for them.

// FEXTRA: a two-byte little-endian length, then that many bytes to skip.
idstd_gz_extra(int[] idstd_src, int idstd_flg, int idstd_at) {
  int idstd_ret_i = idstd_at;
  if ((idstd_flg & 4) != 0) {
    int idstd_xlen = idstd_src[idstd_at] + idstd_src[idstd_at + 1] * 256;
    idstd_ret_i = idstd_at + 2 + idstd_xlen;
  }
} return int idstd_ret_i;
([0, 0, 0], 0, 0):(0)
([2, 0, 9, 9, 65], 4, 0):(4)

// FNAME: the original filename, null-terminated.
idstd_gz_name(int[] idstd_src, int idstd_flg, int idstd_at) {
  int idstd_ret_i = idstd_at;
  if ((idstd_flg & 8) != 0) {
    idstd_ret_i = idstd_gz_skip0(idstd_src, idstd_at);
  }
} return int idstd_ret_i;
([65, 0], 8, 0):(2)
([65, 0], 0, 5):(5)

// FCOMMENT: a free-text comment, also null-terminated.
idstd_gz_comment(int[] idstd_src, int idstd_flg, int idstd_at) {
  int idstd_ret_i = idstd_at;
  if ((idstd_flg & 16) != 0) {
    idstd_ret_i = idstd_gz_skip0(idstd_src, idstd_at);
  }
} return int idstd_ret_i;
([65, 66, 0], 0, 0):(0)
([65, 66, 0], 16, 0):(3)
