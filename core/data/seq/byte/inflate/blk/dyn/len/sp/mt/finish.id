// The empty stored block with BFINAL taken, so idstd_inf_block2 has a second
// type to dispatch on that emits nothing.
idstd_inf_t_block2_empty() {
  idstd_inf_t_empty_block();
  int idstd_inf_bits_v = idstd_inf_bits(1);
} return void;
