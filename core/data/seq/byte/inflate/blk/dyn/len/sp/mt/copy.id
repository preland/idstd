// `at` is a distance back from the end of the output, so the source index is
// computed once, before anything is appended.
idstd_inf_back(int idstd_at, int idstd_n) {
  int[] idstd_xs = [len((import inf_out)) - idstd_at, idstd_n];
  while (idstd_xs[1] > 0) {
    idstd_inf_copy(idstd_xs);
  }
} return void;
