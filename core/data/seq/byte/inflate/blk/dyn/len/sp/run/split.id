// The distance alphabet's slice, once the literal/length one is already cut.
idstd_inf_split2(int[] idstd_buf, int idstd_n, int idstd_k, int[][] idstd_rows) {
  int[] idstd_lst_slice_v2 = lst_slice(idstd_buf, idstd_n, idstd_k);
  int[][] idstd_grid = idstd_inf_tree(idstd_lst_slice_v2);
  idstd_inf_body(idstd_rows, idstd_grid);
} return void;
