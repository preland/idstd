// Splitting one run of code lengths into two alphabets, and the two small
// tables that did not fit beside their neighbours.

// core/data/seq/lst's lst_slice does the cutting. The case is a complete 257-symbol literal/length alphabet where
// only symbol 0 and symbol 256 (end-of-block) have a code, so decoding it
// terminates in exactly one bit -- reachable from idstd_inf_t_init_one --
// rather than needing a real compressed stream.
idstd_inf_split(int[] idstd_buf, int idstd_n, int idstd_k) {
  int[] idstd_lst_slice_v = lst_slice(idstd_buf, 0, idstd_n);
  int[][] idstd_rows = idstd_inf_tree(idstd_lst_slice_v);
  idstd_inf_split2(idstd_buf, idstd_n, idstd_k, idstd_rows);
} return void;
