// The same stream, with the one BFINAL bit and the two BTYPE bits already
// taken -- BFINAL=1, BTYPE=2 (dynamic) -- so a reader that starts at HLIT,
// such as idstd_inf_dynamic and idstd_inf_hdr, is entered where it expects
// to be rather than reading the block header as data.
idstd_inf_t_dyn_ready() {
  idstd_inf_t_dyn_stream();
  int idstd_inf_bits_v = idstd_inf_bits(3);
} return void;
