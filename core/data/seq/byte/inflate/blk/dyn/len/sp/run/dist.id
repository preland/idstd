idstd_inf_t_dyn_stream() {
  int[] idstd_src = [229, 204, 193, 13, 128, 32, 12, 5, 208, 85, 254, 4, 238, 84, 161, 192, 143, 77, 33, 80, 226, 250, 94, 60, 184, 131, 231, 151, 60, 102, 112, 65, 96, 226, 117, 75, 85, 220, 140, 134, 104, 83, 21, 146, 130, 221, 23, 134, 78, 156, 214, 211, 5, 241, 252, 90, 217, 254, 209, 66, 211, 3, 252, 193, 245, 0];
  idstd_inf_init(idstd_src, 0);
  idstd_inf_tabs();
} return void;
