// Dynamic Huffman blocks -- BTYPE 10, where the stream carries its own code
// tables, themselves Huffman-coded.

// Three counts, then a tree to read the code lengths with, then the lengths,
// then the two real trees. idstd_xs is [HLIT, HDIST, HCLEN] after
// idstd_inf_hdr.
idstd_inf_dynamic() {
  int[] idstd_xs = [0, 0, 0];
  idstd_inf_hdr(idstd_xs);
  idstd_inf_dyn(idstd_xs);
} return void;
given idstd_inf_t_dyn_ready ():() then idstd_inf_t_outlen:(304)
given idstd_inf_t_dyn_ready ():() then calls idstd_inf_hdr:[1]

// The three header fields, as separate statements: each one consumes bits, so
// putting them in a list literal would leave the order to the code generator.
// The constants are the biases RFC 1951 section 3.2.7 gives -- there are
// always at least 257 literal codes, one distance code and four code-length
// codes, so those are not transmitted.
idstd_inf_hdr(int[] idstd_xs) {
  idstd_inf_hdr_lit(idstd_xs);
  idstd_inf_hdr_dist(idstd_xs);
  idstd_inf_hdr_clen(idstd_xs);
} return void;
given idstd_inf_t_dyn_stream ([0, 0, 0]):([262, 8, 7])
given idstd_inf_t_dyn_ready ([0, 0, 0]):([285, 13, 18])

// The literal and distance lengths arrive as one run, split afterwards, which
// is what the format does: a repeat code may straddle the boundary between
// the two alphabets.
idstd_inf_dyn(int[] idstd_xs) {
  int[] idstd_inf_clens_v = idstd_inf_clens(idstd_xs[2]);
  int[][] idstd_rows = idstd_inf_tree(idstd_inf_clens_v);
  idstd_inf_dyn2(idstd_xs, idstd_rows);
} return void;
given idstd_inf_t_dyn_direct ([257, 0, 18]):() then idstd_inf_t_outlen:(0)
given idstd_inf_t_dyn_direct ([257, 0, 18]):() then calls idstd_inf_dyn2:[1]
