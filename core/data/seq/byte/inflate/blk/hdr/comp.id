// Type 3 is reserved by RFC 1951 and means the stream is not DEFLATE, or is
// not aligned where the caller thought it was.
idstd_inf_comp(int idstd_n) {
  if (idstd_n == 1) {
    idstd_inf_fixed();
  } else if (idstd_n == 2) {
    idstd_inf_dynamic();
  } else {
    idstd_inf_fail("deflate: reserved block type 3");
  }
} return void;
