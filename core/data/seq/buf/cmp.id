// Comparing two ranges of the flat store.
//
// -1, 0 or 1: the first differing byte decides, and bytes are unsigned, so this
// is the same order `memcmp` gives. There is no break, so every byte is visited
// and the answer is folded -- once one has differed, the rest are read and
// ignored. That makes it O(n) even when the first byte settles it, which is the
// price of the language and not a design choice.
//
// The fold cell is a list because a `while` body cannot both advance an index
// and update an accumulator that the return clause can still see... it can, but
// only by threading it through a helper's return value, and this shape is the
// one the rest of the library uses for a fold.

buf_cmp(word idstd_da, word idstd_sa, int idstd_n) {
  int[] idstd_bs = [0];
  idstd_buf_cmp_loop(idstd_bs, idstd_da, idstd_sa, idstd_n);
  int idstd_ret_i = idstd_bs[0];
} return int idstd_ret_i;
