// Reductions over a list of ints.
//
// lst_min and lst_max coexist for the same reason fx_min and fx_max do: their
// bodies differ by the name of the function they call, which is part of a
// function's fingerprint. lst_sum differs from both by its operator and by the
// two literals it starts from.
//
// **lst_min and lst_max abort on an empty list**, because they start from
// element 0 and an out-of-range list read is a process abort. There is no
// sentinel that would be correct: 2147483647 is a legal element. Check len
// first. lst_sum of an empty list is 0, which is the right answer.

lst_min(int[] idstd_xs) {
  int idstd_m = idstd_xs[0];
  int idstd_i = 1;
  while (idstd_i < len(idstd_xs)) {
    idstd_m = fx_min(idstd_m, idstd_xs[idstd_i]);
    idstd_i = idstd_i + 1;
  }
} return int idstd_m;
([3, 1, 2]):(1)
([5]):(5)

lst_max(int[] idstd_xs) {
  int idstd_m = idstd_xs[0];
  int idstd_i = 1;
  while (idstd_i < len(idstd_xs)) {
    idstd_m = fx_max(idstd_m, idstd_xs[idstd_i]);
    idstd_i = idstd_i + 1;
  }
} return int idstd_m;
([3, 1, 2]):(3)
([5]):(5)

// The total. It wraps like any other int arithmetic -- a thousand elements of a
// million each is 10^9 and fits; ten thousand does not.
lst_sum(int[] idstd_xs) {
  int idstd_m = 0;
  int idstd_i = 0;
  while (idstd_i < len(idstd_xs)) {
    idstd_m = idstd_m + idstd_xs[idstd_i];
    idstd_i = idstd_i + 1;
  }
} return int idstd_m;
([1, 2, 3]):(6)
([]):(0)
