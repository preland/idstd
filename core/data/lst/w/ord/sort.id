// Sorting a list of ints, ascending, in place.
//
// **Insertion sort: O(n^2).** That is a deliberate choice for a first standard
// library and not a placeholder to be embarrassed about. It is stable, it is
// three functions, it needs no scratch list (`id` frees nothing, so a merge
// sort's temporaries are retained for the life of the process), and it is
// fastest of anything for the nearly-sorted lists that a per-frame draw order or
// a re-sorted scoreboard actually presents. It is the wrong answer above a few
// thousand elements; when something needs that, it wants its own name (`lst_qsort`)
// rather than a silent change of complexity underneath existing callers.
//
// There is no comparator parameter because `id` has no function pointers. A sort
// by any other key is a parallel-list sort, which is a different function.

lst_sort(int[] xs) {
  int len_v = len(xs);
  lst_sort_loop(xs, 1, len_v);
} return void;
([3, 1, 2]):([1, 2, 3])
([5, 4, 3, 2, 1]):([1, 2, 3, 4, 5])

lst_sort_loop(int[] xs, int i, int n) {
  while (i < n) {
    lst_sift(xs, i);
    i = i + 1;
  }
} return void;
([3, 1, 2], 1, 3):([1, 2, 3], 1, 3)
([5, 3], 2, 2):([5, 3], 2, 2)

// Walk element i down to its place. The loop condition carries the stop, because
// there is no break -- and the `i > 0` test has to come first, since `xs[i - 1]`
// at i = 0 would abort the process rather than answer anything.
lst_sift(int[] xs, int i) {
  while (i > 0 && xs[i] < xs[i - 1]) {
    lst_swap(xs, i, i - 1);
    i = i - 1;
  }
} return void;
([1, 3, 2], 2):([1, 2, 3], 2)
([1, 2, 3], 0):([1, 2, 3], 0)
