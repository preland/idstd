// trig quadrants -- folding a full turn onto the quarter wave.
//
// sin(q * 90 + r) for r in [0, 90) is the table read forwards in quadrants 0
// and 2 and backwards in 1 and 3, negated in 2 and 3. Four cases do not fit one
// block: an if/else-if/else is already three actions and fills a block by
// itself, so a fourth arm is impossible. The split is therefore a binary tree.
//
// idstd_fx_sin_q01 and idstd_fx_sin_q23 are two functions rather than one because they
// differ in an operator and a literal, which is exactly what the
// function-uniqueness rule looks at.
//
// Lifted from idem/engine/core/math/trig/fold.id.

idstd_fx_sin_q(int idstd_q, int idstd_rm) {
  int idstd_sv = 0;
  if (idstd_q < 2) {
    idstd_sv = idstd_fx_sin_q01(idstd_q, idstd_rm);
  } else {
    idstd_sv = idstd_fx_sin_q23(idstd_q, idstd_rm);
  }
} return int idstd_sv;

idstd_fx_sin_q01(int idstd_q, int idstd_rm) {
  int idstd_sv = idstd_fx_sin_lin(idstd_rm);
  if (idstd_q = 1) {
    idstd_sv = idstd_fx_sin_lin(90000 - idstd_rm);
  }
} return int idstd_sv;

idstd_fx_sin_q23(int idstd_q, int idstd_rm) {
  int idstd_sv = 0 - idstd_fx_sin_lin(idstd_rm);
  if (idstd_q = 3) {
    idstd_sv = 0 - idstd_fx_sin_lin(90000 - idstd_rm);
  }
} return int idstd_sv;
