// The search: the angle of (ax, ay) with 0 <= ay <= ax, so 0..45000.
//
// bs is the two-slot bracket [lo, hi). It starts at [0, 45001) rather than
// [0, 45000] so that lo can reach 45000 itself -- the loop stops with hi one
// past lo and answers lo, so an exclusive upper bound of 45000 could never
// return the diagonal. ay = 0 skips the search entirely and answers 0, which is
// the x axis exactly.

idstd_fx_atan_oct(int idstd_ax, int idstd_ay) {
  int[] idstd_bs = [0, 45001];
  if (idstd_ay > 0) {
    idstd_fx_atan_loop(idstd_bs, idstd_ax, idstd_ay);
  }
  int idstd_ret_i = idstd_bs[0];
} return int idstd_ret_i;
(12345, 0):(0)

// Seventeen halvings, give or take: 45001 < 2^16, and the loop ends when the
// bracket is one millidegree wide.
idstd_fx_atan_loop(int[] idstd_bs, int idstd_ax, int idstd_ay) {
  while (idstd_bs[1] - idstd_bs[0] > 1) {
    idstd_fx_atan_step(idstd_bs, idstd_ax, idstd_ay);
  }
} return void;

idstd_fx_atan_step(int[] idstd_bs, int idstd_ax, int idstd_ay) {
  int idstd_m = (idstd_bs[0] + idstd_bs[1]) / 2;
  if (idstd_fx_atan_hi(idstd_m, idstd_ax, idstd_ay) = 1) {
    lset(idstd_bs, 0, idstd_m);
  } else {
    lset(idstd_bs, 1, idstd_m);
  }
} return void;
