// trig -- sin and cos of an angle in millidegrees.
//
// Angles are millidegrees (degree x 1000) everywhere in this library, per
// README.md's scale table, and the results are x1000, so fx_sin returns
// -1000..1000.
//
// The table has one entry per whole degree, which is a 1-degree step -- visible
// as a stutter on anything that rotates slowly, and as a 17-per-mille jump in a
// velocity vector near zero. So the sub-degree remainder is used to interpolate
// between neighbouring entries instead of being thrown away. Between two entries
// the sine is near enough linear that the error stays under one part in a
// thousand, which is the whole precision of the scale.
//
// Lifted from idem/engine/core/math/trig/sin.id.

fx_sin(int idstd_deg) {
  int idstd_ndg = fx_norm_deg(idstd_deg);
  int idstd_ret_i = idstd_fx_sin_qr(idstd_ndg);
} return int idstd_ret_i;
given fx_trig_init (30000):(500)
given fx_trig_init (-30000):(-500)

// The normalised angle split into quadrant and remainder, and handed to the
// quadrant fold -- split out so fx_sin stays inside the action limit.
idstd_fx_sin_qr(int idstd_ndg) {
  int idstd_q = idstd_ndg / 90000;
  int idstd_rm = idstd_ndg % 90000;
  int idstd_ret_i = idstd_fx_sin_q(idstd_q, idstd_rm);
} return int idstd_ret_i;
given fx_trig_init (30000):(500)
given fx_trig_init (330000):(-500)

// cos is sin a quarter turn ahead. The normalise happens first because deg may
// be anywhere in the int range and deg + 90000 would wrap.
fx_cos(int idstd_deg) {
  int idstd_ndg = fx_norm_deg(idstd_deg);
  int idstd_ret_i = fx_sin(idstd_ndg + 90000);
} return int idstd_ret_i;
given fx_trig_init (0):(1000)
given fx_trig_init (60000):(500)
