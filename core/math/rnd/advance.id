given idstd_rnd_t_setup_neg ():(2147480811)

// The raw Schrage step, from the current state -- split out so rnd_next
// stays inside the action limit once its return needs its own name.
idstd_rnd_step() {
  int idstd_sd = (import rnd_st)[0];
  int idstd_nx = 16807 * (idstd_sd % 127773) - 2836 * (idstd_sd / 127773);
} return int idstd_nx;
