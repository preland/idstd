// fx limits -- clamp, sign, and the per-mille blend.
//
// These are the three shapes that would otherwise be written inline at a
// hundred call sites, each one an `if` eating one of a block's three actions.
// As functions they are free: the return clause after a function's closing brace
// costs nothing, so a caller pays no action budget for using them.
//
// fx_lerp's t is per-mille (1000 = all the way to b), the scale-factor row of
// README.md's table, and it multiplies before dividing -- the other order throws
// away every bit of the fraction.
//
// Lifted from idem/engine/core/math/fx/lim.id.

fx_clamp(int a, int lo, int hi) {
  int fx_max_v = fx_max(a, lo);
  int ret_i = fx_min(fx_max_v, hi);
} return int ret_i;
(5, 0, 10):(5)
(-5, 0, 10):(0)
(99, 0, 10):(10)

// -1, 0, or 1. A comparison yields int 0 or 1, so the difference of the two
// tests is the sign directly. The parentheses are load-bearing: `-` binds
// tighter than `>` in this language, so `a > 0 - (a < 0)` would parse.
fx_sign(int a) {
  int ret_i = (a > 0) - (a < 0);
} return int ret_i;
(-9):(-1)
(0):(0)
(9):(1)

// The span b-a reaches 2^32 for extreme operands and t reaches 1000, so the
// product is computed in a word and narrowed once on the way out.
fx_lerp(int a, int b, int t) {
  word wp = b;
  wp = (wp - a) * t / 1000;
  int ret_i = a + wp;
} return int ret_i;
(0, 1000, 250):(250)
(10, 20, 500):(15)
(5, 5, 700):(5)
