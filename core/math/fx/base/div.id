// Division that rounds toward negative infinity.
//
// docs/SPEC.md 2.2 says `/` truncates toward zero. That is the right rule and
// it is not the one coordinate arithmetic wants. A rasteriser is where it
// bites hardest, because half of a glyph's coordinates are negative on
// purpose -- everything above the baseline is -- and truncation puts those
// pixels one row out. The failure is a glyph one pixel wrong rather than an
// error, and nothing in the language or this library warned about it, so
// every program doing coordinate arithmetic has written the same three lines
// (docs/FRICTION.md 21 in the id repository).

fx_fdiv(int idstd_a, int idstd_b) {
  int idstd_n = idstd_a / idstd_b;
  int idstd_m = idstd_n * idstd_b;
  if (idstd_m != idstd_a) {
    idstd_n = idstd_fx_fdown(idstd_n, idstd_a, idstd_b);
  }
} return int idstd_n;
(7, 2):(3)
(-7, 2):(-4)
(-8, 2):(-4)
(7, -2):(-4)

// One less, but only when the exact quotient was negative -- which is when the
// two operands disagree about sign. A remainder already exists by the time
// this is called, so an exact division is never adjusted.
idstd_fx_fdown(int idstd_n, int idstd_a, int idstd_b) {
  int idstd_sg = fx_sign(idstd_a) * fx_sign(idstd_b);
  int idstd_k = idstd_n;
  if (idstd_sg < 0) {
    idstd_k = idstd_n - 1;
  }
} return int idstd_k;
(3, 7, 2):(3)
(-3, -7, 2):(-4)
