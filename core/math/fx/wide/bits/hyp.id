// The 2D and 3D magnitudes, and the wide square they share.
//
// Lifted from idem/engine/core/math/fx/wide/mul/mul.id and hyp3.id.

// sqrt(a*a + b*b), exact whenever the answer itself fits an int -- so up to
// operands of about 1.5e9 together, or 2.1e9 alone. Both squares are accumulated
// in words because a single 46000^2 is already within a rounding error of the int
// range and their sum is twice over it, and idstd_fx_hypfix recurses down to fx_sqrt's
// int domain from there. Past that ceiling the *result* is what overflows, and no
// amount of width underneath helps.
fx_hyp(int idstd_a, int idstd_b) {
  word idstd_sm = idstd_fx_hyp_sm2(idstd_a, idstd_b);
  int idstd_ret_i = idstd_fx_hypfix(idstd_sm);
} return int idstd_ret_i;
(3, 4):(5)
(0, 0):(0)
(30000, 40000):(50000)

// sqrt(a*a + b*b + c*c) -- a 3D magnitude in one root rather than two.
//
// fx_hyp(fx_hyp(a, b), c) is the same number and costs a second digit-by-digit
// square root, which is sixteen iterations of a loop with two calls in each. That
// is nothing once and everything per triangle: halving the roots halved the time
// idem's whole renderer spent in this file.
fx_hyp3(int idstd_a, int idstd_b, int idstd_c) {
  word idstd_sm = idstd_fx_hyp_sm2(idstd_a, idstd_b);
  idstd_sm = idstd_sm + fx_sq(idstd_c);
  int idstd_ret_i = idstd_fx_hypfix(idstd_sm);
} return int idstd_ret_i;
(2, 3, 6):(7)
(0, 0, 0):(0)

// a*a + b*b, widened -- the sum both fx_hyp and fx_hyp3 start from.
idstd_fx_hyp_sm2(int idstd_a, int idstd_b) {
  word idstd_sm = idstd_a;
  word idstd_hs = idstd_b;
  idstd_sm = idstd_sm * idstd_a + idstd_hs * idstd_b;
} return word idstd_sm;
(3, 4):(25)
(0, 0):(0)
(-5, 0):(25)
