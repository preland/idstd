// fx sqrt digits -- one step of the base-4 recurrence, and the wide fixup.
//
// Split out from sqrt.id because the step is two writes and the decision around
// it is two more actions: a block holds three, so the taken branch has to be its
// own function. The order inside idstd_fx_sqtake matters -- slot 0 is updated using the
// old slot 1, so the remainder must be written before the root is.
//
// Lifted from idem/engine/core/math/fx/wide/bits/bits.id.

idstd_fx_sqstep(int[] idstd_sq, int idstd_bt) {
  if (idstd_sq[0] >= idstd_sq[1] + idstd_bt) {
    idstd_fx_sqtake(idstd_sq, idstd_bt);
  } else {
    lset(idstd_sq, 1, idstd_sq[1] / 2);
  }
} return void;
([10, 4], 2):([4, 4], 2)
([3, 10], 5):([3, 5], 5)

idstd_fx_sqtake(int[] idstd_sq, int idstd_bt) {
  lset(idstd_sq, 0, idstd_sq[0] - idstd_sq[1] - idstd_bt);
  lset(idstd_sq, 1, idstd_sq[1] / 2 + idstd_bt);
} return void;
([10, 4], 2):([4, 4], 2)
([100, 20], 8):([72, 18], 8)

// The square root of a word too wide for fx_sqrt's int parameter.
//
// sqrt(n) is either 2*sqrt(n/4) or that plus one -- because (2k)^2 <= n whenever
// k^2 <= n/4, and (2k+2)^2 = 4*(k+1)^2 >= 4*(n/4 + 1) > n. So one root of the
// quartered value plus a single wide test gives the exact floor, and no 64-bit
// square root has to exist.
//
// The identity is exact at every level, so it may be applied repeatedly: fx_wroot
// quarters again whenever the value is still outside fx_sqrt's domain. That
// matters more than it looks. fx_sqrt is exact only for a < 2^31 -- above that
// it silently returns a root that is far too small, with no fault and no clue.
// A single quartering covers operands up to 65535; recursing covers the whole
// word. idem hit this the first time a surface normal was measured: components
// of two million made every Lambert term saturate, and a lit room came out as
// flat as an unlit one.
idstd_fx_hypfix(word idstd_sm) {
  int idstd_m = 2 * fx_wroot(idstd_sm / 4);
  word idstd_hs = idstd_m + 1;
  idstd_m = idstd_m + (idstd_hs * idstd_hs <= idstd_sm);
} return int idstd_m;
(1000000):(1000)
(5000000000):(70710)
