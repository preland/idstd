// The recursion step: quarter again, or hand the last of it to fx_sqrt.
//
// The threshold is below 2^31 - 1 because fx_sqrt's exactness is stated over
// 0..2^31-1 and nothing is gained by sitting on the boundary. Depth is at most
// sixteen: each level takes two bits off a value that started with sixty-three.
//
// Lifted from idem/engine/core/math/fx/wide/bits/root.id.

fx_wroot(word idstd_sm) {
  int idstd_m = 0;
  if (idstd_sm > 2000000000) { idstd_m = idstd_fx_hypfix(idstd_sm); } else { idstd_m = idstd_fx_wsmall(idstd_sm); }
} return int idstd_m;
(1000000):(1000)
(2000000000):(44721)
(4000000000):(63245)

// The narrowing, written down where the guard that makes it safe can be seen:
// the else branch above has already established that sm is below 2^31, which
// is the range fx_sqrt states its exactness over.
idstd_fx_wsmall(word idstd_sm) {
  int idstd_sn = idstd_sm;
  int idstd_ret_i = fx_sqrt(idstd_sn);
} return int idstd_ret_i;
