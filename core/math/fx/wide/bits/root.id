(4000000000):(63245)

// The narrowing, written down where the guard that makes it safe can be seen:
// the else branch above has already established that sm is below 2^31, which
// is the range fx_sqrt states its exactness over.
fx_wsmall(word sm) {
  int sn = sm;
  int ret_i = fx_sqrt(sn);
} return int ret_i;
(4):(2)
