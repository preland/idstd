// fx wide -- the scaled operations, and the only place that owns the narrowing.
//
// A product of two x1000 quantities already reaches 10^6, a distance in
// millunits squared reaches 10^9, and `int` is 32 bits and wraps *silently* --
// no trap, no warning, just a wrong-looking number. So every fixed-point
// multiply and divide goes through here, computes in a `word` (64-bit), and
// narrows exactly once on the way out. No caller repeats that reasoning.
//
// The guards answer 0 rather than dividing. Division by zero is a clean abort in
// both widths (`id: division by zero`), but an abort is still a dead program: a
// scale that happens to be 0 is a caller bug, and a wrong-looking number is a
// better report of it than a process that vanishes.
//
// Lifted from idem/engine/core/math/fx/wide/mul/mul.id; fx_pow is new.

// (a * b) / sc, with sc the fixed-point scale (1000 for this library's units).
fx_mul(int idstd_a, int idstd_b, int idstd_sc) {
  word idstd_wp = 0;
  if (idstd_sc != 0) {
    idstd_wp = idstd_a;
    idstd_wp = idstd_wp * idstd_b / idstd_sc;
  }
  int idstd_ret_i = idstd_wp;
} return int idstd_ret_i;
(2000, 3000, 1000):(6000)
(-2000, 3000, 1000):(-6000)
(1234, 5678, 0):(0)

// (a * sc) / b -- the inverse, so `fx_div(x, y, 1000)` is x/y in per-mille.
fx_div(int idstd_a, int idstd_b, int idstd_sc) {
  word idstd_wp = 0;
  if (idstd_b != 0) {
    idstd_wp = idstd_a;
    idstd_wp = idstd_wp * idstd_sc / idstd_b;
  }
  int idstd_ret_i = idstd_wp;
} return int idstd_ret_i;
(6000, 3000, 1000):(2000)
(-6000, 3000, 1000):(-2000)
(5000, 0, 1000):(0)

// a to the power n, for n >= 0; a negative exponent answers 1, since there is no
// fraction to answer with and 0 would be a worse lie. Recursion rather than a
// loop because a loop needs two mutable locals and a block holds three actions.
//
// This one does NOT widen: the result is an int and every intermediate is an
// int, so it wraps exactly as `a * a * a` written by hand would. Anything that
// needs the wide answer wants fx_mul with a scale, not this.
fx_pow(int idstd_a, int idstd_n) {
  int idstd_m = 1;
  if (idstd_n > 0) {
    idstd_m = idstd_a * fx_pow(idstd_a, idstd_n - 1);
  }
} return int idstd_m;
(2, 10):(1024)
(5, 0):(1)
(2, -3):(1)
