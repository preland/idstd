// fx base -- the three comparisons `id` does not ship.
//
// There is no abs/min/max builtin, and none of the 30 builtins is arithmetic
// beyond the operators. So these are the floor of the whole library, and
// everything above them (clamping a span, folding a quadrant, biasing a colour)
// is written in terms of these rather than repeating an `if`.
//
// fx_min and fx_max coexist only because they differ by an operator -- two
// functions whose bodies match up to renaming their own locals are a compile
// error, so `<` versus `>` is what makes them two functions rather than one.
// That is also why a user program must not write its own `biggest(a, b)`: the
// duplicate-logic rule crosses the import boundary and will name fx_max.
//
// Lifted from idem/engine/core/math/fx/base.id.

// abs as max(a, -a): no local, no branch, and it reuses fx_max instead of
// spelling a second comparison. Note that -2147483648 has no positive
// counterpart in 32 bits and comes back unchanged; that input is out of range
// for every fixed-point quantity in README.md's scale table.
fx_abs(int a) {
} return int fx_max(a, 0 - a);

fx_min(int a, int b) {
  int m = a;
  if (b < a) {
    m = b;
  }
} return int m;

fx_max(int a, int b) {
  int m = a;
  if (b > a) {
    m = b;
  }
} return int m;
