chr_is_alnum(int c) {
} return int chr_is_alpha(c) || chr_is_digit(c);
(48):(1)
(32):(0)

// Space, tab, newline, carriage return. Vertical tab and form feed are left out:
// nothing in this language produces them and a `trim` that ate them would
// surprise more than it helped.
chr_is_space(int c) {
} return int c = 32 || c = 9 || c = 10 || c = 13;
(10):(1)
(65):(0)
