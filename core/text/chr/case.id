// Case, and the hex digit.
//
// chr_upper and chr_lower differ by the predicate they call and by the sign of
// the shift, which is what makes them two functions. Anything that is not a
// letter comes back unchanged, including -1, so these are safe to apply to the
// result of a charat past the end.

chr_upper(int idstd_c) {
  int idstd_v = idstd_c;
  if (chr_is_lower(idstd_c) = 1) {
    idstd_v = idstd_c - 32;
  }
} return int idstd_v;
(97):(65)
(-1):(-1)

chr_lower(int idstd_c) {
  int idstd_v = idstd_c;
  if (chr_is_upper(idstd_c) = 1) {
    idstd_v = idstd_c + 32;
  }
} return int idstd_v;
(90):(122)
(-1):(-1)

// The byte code of the hex digit for a nibble 0..15: '0'..'9' then lowercase
// 'a'..'f'. 87 is 'a' - 10. Out-of-range input answers nonsense rather than
// aborting, because every caller in this library masks first.
chr_hex(int idstd_v) {
  int idstd_c = 48 + idstd_v;
  if (idstd_v > 9) {
    idstd_c = 87 + idstd_v;
  }
} return int idstd_c;
(5):(53)
(15):(102)
