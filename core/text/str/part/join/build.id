// Joining a list of strings with a separator between them.
//
// Two passes: measure, then write. The one-pass version is
// `r = r + strs[i] + sep` in a loop, which is the quadratic shape this module
// exists to avoid -- joining 1000 short strings that way allocates and retains
// about half a megabyte of intermediates for a 10 KB answer. Measuring first
// costs one extra walk of the list and one strlen per element, and then the
// whole result is one allocation and one str_of_mem.

str_join(string[] idstd_strs, string idstd_sep) {
  int idstd_n = idstd_str_join_len(idstd_strs, idstd_sep);
  word idstd_ad = alloc(idstd_n + 1);
  string idstd_ret_s = idstd_str_join_blit(idstd_strs, idstd_sep, idstd_ad, idstd_n);
} return string idstd_ret_s;
(["a", "b", "c"], ","):("a,b,c")
([], ","):("")
(["x"], ","):("x")

// The exact byte count: every piece, plus one separator between each adjacent
// pair. An empty list has no separators and no pieces, so the answer is 0 and
// str_of_mem gives "".
idstd_str_join_len(string[] idstd_strs, string idstd_sep) {
  int idstd_n = idstd_str_join_base(idstd_strs, idstd_sep);
  int idstd_i = 0;
  while (idstd_i < len(idstd_strs)) {
    idstd_n = idstd_n + len(idstd_strs[idstd_i]);
    idstd_i = idstd_i + 1;
  }
} return int idstd_n;
(["a", "bb", "ccc"], ","):(8)
([], ","):(0)
(["x"], "::"):(1)

// bs is the two-slot cursor: 0 is the element index, 1 is the write offset. It
// is a list because the loop body has to advance both and still be one action.
idstd_str_join_blit(string[] idstd_strs, string idstd_sep, word idstd_ad, int idstd_n) {
  int[] idstd_bs = [0, 0];
  while (idstd_bs[0] < len(idstd_strs)) {
    idstd_str_join_one(idstd_bs, idstd_strs, idstd_sep, idstd_ad);
  }
  string idstd_ret_s = str_of_mem(idstd_ad, idstd_n);
} return string idstd_ret_s;
given idstd_str_t_setup (["a", "b", "c"], ",", (import str_ad), 5):("a,b,c")
given idstd_str_t_setup ([], ",", (import str_ad), 0):("")
