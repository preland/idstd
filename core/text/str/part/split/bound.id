// The end of the current field: the next separator, or the end of s if
// there is none.
str_split_bound(string s, string sep, int i) {
  int str_findat_v = str_findat(s, sep, i);
  int len_v = len(s);
  int ret_i = str_split_cut(str_findat_v, len_v);
} return int ret_i;
("a,b", ",", 0):(1)
("abc", ",", 0):(3)

// The field itself, sliced out and appended.
str_split_push(string[] strs, string s, int i, int n) {
  string str_slice_v = str_slice(s, i, n - i);
  push(strs, str_slice_v);
} return void;
