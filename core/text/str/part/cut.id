// Where the current field ends: the separator's index, or the end of the string
// when there is no separator left.
//
// Its own function because the caller's block is already three actions, and
// because "-1 means not found, and not found means the end" is a decision worth
// having one place rather than at every use of str_findat.
idstd_str_split_cut(int idstd_at, int idstd_n) {
  int idstd_m = idstd_n;
  if (idstd_at >= 0) {
    idstd_m = idstd_at;
  }
} return int idstd_m;
(3, 10):(3)
(-1, 10):(10)

// Where the line holding index i ends: the index of the next newline, or the
// length of the string when no newline follows. A reader that walks a text one
// line at a time needs exactly this, and five programs had each written it.
// Both tests read the same string, so charat's one-string memo holds.
str_eol(string idstd_s, int idstd_i) {
  while(charat(idstd_s, idstd_i) != 10 && charat(idstd_s, idstd_i) != -1) {
    idstd_i = idstd_i + 1;
  }
} return int idstd_i;
("ab\ncd", 0):(2)
("ab\ncd", 3):(5)
