// -1 when the first non-space character is a minus sign, 1 otherwise.
//
// to_int consumes the sign and applies it to the integer part; the fraction is
// parsed unsigned, so the sign has to be reapplied to it separately or "-0.5"
// comes back as +0.5 (the integer part being 0, which carries no sign at all).
// That is the bug this function exists to prevent, and it is invisible in every
// test case whose integer part is nonzero.

idstd_str_sgn(string idstd_s) {
  int idstd_v = 1;
  int idstd_str_ws_start_v = idstd_str_ws_start(idstd_s, 0);
  if (charat(idstd_s, idstd_str_ws_start_v) = 45) {
    idstd_v = 0 - 1;
  }
} return int idstd_v;
("  -7"):(-1)
("5"):(1)
