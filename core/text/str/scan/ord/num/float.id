// Parsing a decimal into a float.
//
// **There is no `to_float` builtin**, and `to_int` cannot be made into one: the
// fraction's *length* is what scales it, and to_int has already thrown that away
// by the time it answers. So the integer part comes from to_int (which handles
// leading space, the sign and a trailing tail exactly as C's atoi does) and the
// fraction is walked here.
//
// This is the one place in idstd that speaks `float`. The rest of the library is
// fixed point, deliberately -- see README.md, "Decisions" -- and a `flt_` mirror
// is deferred rather than rejected.
//
// Accuracy: each digit multiplies a `double` by a tenth, so the usual binary
// representation error applies and "0.1" is 0.1000000000000000055. Printing is
// lossier still -- `print` uses %g and shows six significant digits. For exact
// output, scale to an int and print that.

str_to_float(string idstd_s) {
  int idstd_at = str_find(idstd_s, ".");
  float idstd_fv = idstd_str_frac(idstd_s, idstd_at);
  float idstd_ret_f = to_int(idstd_s) + idstd_fv * idstd_str_sgn(idstd_s);
} return float idstd_ret_f;
("3.5"):(3.5)
("-2.25"):(-2.25)

// The fractional part alone, 0.0 <= fv < 1.0, from the digits after the '.' at
// index at. No '.' (at < 0) means no fraction. The sign is not applied here --
// str_to_float reapplies it, because to_int has already consumed it.
idstd_str_frac(string idstd_s, int idstd_at) {
  float idstd_fv = 0.0;
  if (idstd_at >= 0) {
    idstd_fv = idstd_str_frac_run(idstd_s, idstd_at + 1, 0.1, 0.0);
  }
} return float idstd_fv;
("3.5", 1):(0.5)
("42", -1):(0.0)

// dv is the place value of the next digit: a tenth, then a hundredth, and so on.
// The loop stops at the first non-digit, so "1.5abc" parses as 1.5, matching
// to_int's tolerance for a tail.
idstd_str_frac_run(string idstd_s, int idstd_i, float idstd_dv, float idstd_fv) {
  while (idstd_chr_is_digit_at(idstd_s, idstd_i) = 1) {
    idstd_fv = idstd_fv + idstd_dv * (charat(idstd_s, idstd_i) - 48);
    idstd_dv = idstd_dv / 10.0;
    idstd_i = idstd_i + 1;
  }
} return float idstd_fv;
("125", 0, 0.1, 0.0):(0.125)
("abc", 0, 0.1, 0.0):(0.0)
