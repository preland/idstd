// The per-byte work of idstd_str_lower_blit and idstd_str_upper_blit, split out because
// the read-convert-write is already three actions and the loop that drives
// it is a fourth. Two functions rather than one with a flag, same as
// str_lower and str_upper themselves: they differ only by the per-byte
// function they call.

idstd_str_lower_step(string idstd_s, word idstd_ad, int idstd_i) {
  int idstd_charat_v = charat(idstd_s, idstd_i);
  int idstd_chr_lower_v = chr_lower(idstd_charat_v);
  poke8(idstd_ad + idstd_i, idstd_chr_lower_v);
} return void;
given idstd_txt_t_setup ("A", (import txt_ad), 0):() then idstd_txt_t_read:("a...............")
given idstd_txt_t_setup ("XXXA", (import txt_ad), 3):() then idstd_txt_t_read:("...a............")

idstd_str_upper_step(string idstd_s, word idstd_ad, int idstd_i) {
  int idstd_charat_v = charat(idstd_s, idstd_i);
  int idstd_chr_upper_v = chr_upper(idstd_charat_v);
  poke8(idstd_ad + idstd_i, idstd_chr_upper_v);
} return void;
given idstd_txt_t_setup ("a", (import txt_ad), 0):() then idstd_txt_t_read:("A...............")
given idstd_txt_t_setup ("xxxa", (import txt_ad), 3):() then idstd_txt_t_read:("...A............")
