// Upper-casing, through the store.
//
// One allocation and one pass. The obvious version -- `r = r + chr(chr_upper(c))`
// in a loop -- is quadratic in both time and retained memory, which is why this
// module has a rule about it (see make/cut.id).
//
// The blit loop tests `charat(s, i) >= 0` rather than `i < len(s)`, so the walk
// is O(1) per byte; the single `len(s)` here is evaluated once, to size the
// allocation.

str_upper(string idstd_s) {
  int idstd_n = len(idstd_s);
  word idstd_ad = idstd_str_upper_alloc(idstd_s, idstd_n);
  string idstd_ret_s = str_of_mem(idstd_ad, idstd_n);
} return string idstd_ret_s;
("Hello, World!"):("HELLO, WORLD!")
(""):("")

// The allocation and the blit together, so str_upper's own block stays
// inside the action limit.
idstd_str_upper_alloc(string idstd_s, int idstd_n) {
  word idstd_ad = alloc(idstd_n + 1);
  idstd_str_upper_blit(idstd_s, idstd_ad, 0);
} return word idstd_ad;
("ab", 2):(8)
("", 0):(8)

idstd_str_upper_blit(string idstd_s, word idstd_ad, int idstd_i) {
  while (charat(idstd_s, idstd_i) >= 0) {
    idstd_str_upper_step(idstd_s, idstd_ad, idstd_i);
    idstd_i = idstd_i + 1;
  }
} return void;
given idstd_txt_t_setup ("abc", (import txt_ad), 0):() then idstd_txt_t_read:("ABC.............")
given idstd_txt_t_setup ("", (import txt_ad), 0):() then idstd_txt_t_read:("................")
