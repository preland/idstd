// Lower-casing. The mirror of up.id, and two functions rather than one with a
// flag: they differ only by the name of the per-byte function they call, which
// is part of a function's fingerprint and therefore enough to make them legal
// siblings. A flag would be a bare literal at every call site.

str_lower(string s) {
  int n = len(s);
  word ad = str_lower_alloc(s, n);
  string ret_s = str_of_mem(ad, n);
} return string ret_s;
("Hello, World!"):("hello, world!")
("ABC123"):("abc123")

// The allocation and the blit together, so str_lower's own block stays
// inside the action limit.
str_lower_alloc(string s, int n) {
  word ad = alloc(n + 1);
  str_lower_blit(s, ad, 0);
} return word ad;

str_lower_blit(string s, word ad, int i) {
  while (charat(s, i) >= 0) {
    str_lower_step(s, ad, i);
    i = i + 1;
  }
} return void;
