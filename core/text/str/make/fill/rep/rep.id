// s repeated n times, in one allocation.
//
// This is the function that makes a rule out of a horizontal line: the loop
// writes into the store and the string is materialised once, so repeating a
// 2-character string 1000 times costs one allocation of 2001 bytes rather than
// a thousand allocations totalling a megabyte.
//
// n <= 0 gives the empty string: m is then 0 or negative, the loop does not run,
// and str_of_mem of a negative length would be the caller's fault -- so m is
// floored at 0.

str_repeat(string idstd_s, int idstd_n) {
  int idstd_m = idstd_str_rep_width(idstd_s, idstd_n);
  word idstd_ad = alloc(idstd_m + 1);
  string idstd_ret_s = idstd_str_rep_build(idstd_s, idstd_ad, idstd_m, idstd_n);
} return string idstd_ret_s;
("ab", 3):("ababab")
("x", 0):("")
("hi", -2):("")
