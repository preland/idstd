// The first index that is not whitespace. charat answers -1 at the end and
// chr_is_space(-1) is 0, so the walk stops there without a bound test.
idstd_str_ws_start(string idstd_s, int idstd_i) {
  while (idstd_chr_is_space_at(idstd_s, idstd_i) = 1) {
    idstd_i = idstd_i + 1;
  }
} return int idstd_i;
("   abc", 0):(3)
("abc", 0):(0)

// One past the last index that is not whitespace. Walking backwards needs the
// explicit `n > 0`, because charat of a negative index is not the end sentinel.
idstd_str_ws_end(string idstd_s, int idstd_n) {
  while (idstd_n > 0 && idstd_chr_is_space_at(idstd_s, idstd_n - 1) = 1) {
    idstd_n = idstd_n - 1;
  }
} return int idstd_n;
("abc   ", 6):(3)
("abc", 3):(3)

// chr_is_space of the byte at i, named so it can sit inside a while
// condition without a call becoming an argument to another call.
idstd_chr_is_space_at(string idstd_s, int idstd_i) {
  int idstd_charat_v = charat(idstd_s, idstd_i);
  int idstd_ret_i = chr_is_space(idstd_charat_v);
} return int idstd_ret_i;
("  x", 0):(1)
("  x", 2):(0)
