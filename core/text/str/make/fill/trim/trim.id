// Trimming whitespace from both ends.
//
// A string that is entirely whitespace gives "": str_ws_start walks to the end
// and str_ws_end walks back to 0, so the span is negative and is floored. That
// case is worth stating because it is the one a line-oriented reader hits on
// every blank line.
//
// The two walkers are separate functions because they differ in direction, and
// separate from a general "scan while" because there is no way to pass a
// predicate in this language.

str_trim(string s) {
  int i = str_ws_start(s, 0);
  int n = str_trim_end(s);
  string ret_s = str_trim_slice(s, i, n);
} return string ret_s;
("  hello  "):("hello")
("   "):("")
("no-trim"):("no-trim")

// The far end of s, for str_ws_end to walk back from.
str_trim_end(string s) {
  int len_v = len(s);
  int ret_i = str_ws_end(s, len_v);
} return int ret_i;
("  hello  "):(7)
("no-trim"):(7)

// The span between the two walks, floored at 0 for an all-whitespace s where
// the end walk lands before the start walk, then sliced out.
str_trim_slice(string s, int i, int n) {
  int fx_max_v = fx_max(n - i, 0);
  string ret_s = str_slice(s, i, fx_max_v);
} return string ret_s;
