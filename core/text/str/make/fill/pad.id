// Padding a string out to a width, on the right: the text, then spaces.
//
// A string longer than n comes back unchanged rather than truncated, because a
// truncated label in a column is a bug that looks like a layout decision.
//
// fmt_pad is the mirror -- spaces first, text last, for a column of numbers --
// and lives with the other display formatters. The two are separate functions
// with separate names rather than one taking a side flag, so that neither call
// site carries a bare literal nobody can read.

str_pad(string s, int n) {
  int m = fx_max(n, len(s));
  word ad = alloc(m + 1);
  str_pad_fill(s, ad, m);
} return string str_of_mem(ad, m);

str_pad_fill(string s, word ad, int m) {
  buf_fill(ad, m, 32);
  str_blit(s, 0, len(s), ad);
} return void;
