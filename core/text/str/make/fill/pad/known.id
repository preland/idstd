// Test fixtures for core/text (internal): a 16-byte buffer marked with a
// sentinel byte ('.'), and a way to read the whole thing back as a string.
// A case's setup takes no arguments, and a flat-store address is only valid
// once alloc() has returned it, which is why these are functions of their
// own rather than case literals.
idstd_str_t_setup() {
  export word str_ad = alloc(16);
  idstd_str_t_mark();
} return void;
():() then idstd_str_t_read:("................")
():() then eprints:("")

idstd_str_t_mark() {
  int idstd_i = 0;
  while (idstd_i < 16) {
    poke8((import str_ad) + idstd_i, 46);
    idstd_i = idstd_i + 1;
  }
} return void;
given idstd_str_t_setup ():() then idstd_str_t_read:("................")
given idstd_str_t_setup ():() then eprints:("")

idstd_str_t_read() {
  string idstd_ret_s = str_of_mem((import str_ad), 16);
} return string idstd_ret_s;
given idstd_str_t_setup ():("................")
given idstd_str_t_setup ():("................") then eprints:("")
