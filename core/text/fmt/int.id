// fmt -- formatting for display.
//
// fmt_pad is str_pad's mirror: spaces first, text last, so a column of numbers
// lines up on its right edge. They are two functions rather than one with a side
// flag, because the flag would be a bare 0 or 1 at every call site and nobody
// reading the call could tell which way it went.

// v right-aligned in a field at least n wide. `"" + v` is the int-to-string path
// -- there is no str_of_int here and there cannot be, because the runtime's own
// C helper is already called id_str_of_int and an `id` function of that name is
// a hard compilation failure.
//
// The width is `n` and not the `w` that would read better, because `w` is the
// name a graphics program wants for a width and a lexer wants for a word: this
// library claims a name only where it has no alternative. NAMES.md section 2.
fmt_int(int idstd_v, int idstd_n) {
  string idstd_ret_s = fmt_pad("" + idstd_v, idstd_n);
} return string idstd_ret_s;
(5, 4):("   5")
(12345, 3):("12345")
(-7, 3):(" -7")

fmt_pad(string idstd_s, int idstd_n) {
  int idstd_m = idstd_fmt_pad_width(idstd_s, idstd_n);
  word idstd_ad = alloc(idstd_m + 1);
  string idstd_ret_s = idstd_fmt_pad_build(idstd_s, idstd_ad, idstd_m);
} return string idstd_ret_s;
("ab", 5):("   ab")
("hello world", 3):("hello world")
