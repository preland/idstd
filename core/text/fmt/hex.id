// A 32-bit value as exactly eight lowercase hex digits, no prefix.
//
// Fixed width rather than minimal, for two reasons: a column of them lines up,
// and a negative int shows its two's-complement pattern instead of a minus sign
// in front of a magnitude, which is what "print the bits" means. `0xRRGGBB`
// colours therefore read as `00rrggbb`.
//
// `>>` in this language is an *arithmetic* shift, so the top nibble of a negative
// value arrives sign-extended; the `& 15` is what makes each nibble right anyway,
// and it is the reason no unsigned shift is needed here.

fmt_hex(int idstd_n) {
  word idstd_ad = alloc(9);
  idstd_fmt_hex_run(idstd_ad, idstd_n, 0);
  string idstd_ret_s = str_of_mem(idstd_ad, 8);
} return string idstd_ret_s;
(0):("00000000")
(-1):("ffffffff")
(0x12345678):("12345678")

// Most significant nibble first: digit i is bits (28 - 4i) .. (31 - 4i).
idstd_fmt_hex_run(word idstd_ad, int idstd_n, int idstd_i) {
  while (idstd_i < 8) {
    int idstd_chr_hex_v = chr_hex((idstd_n >> (28 - idstd_i * 4)) & 15);
    poke8(idstd_ad + idstd_i, idstd_chr_hex_v);
    idstd_i = idstd_i + 1;
  }
} return void;
