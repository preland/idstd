// fx_pow, then fx_sqrt and fx_hyp.
//
// fx_pow's last case is the documented wrap: 2^31 does not fit an int, and this
// language's overflow is silent, so the answer is -2147483648. Asserting it is
// how the header's claim ("it wraps exactly as a * a * a written by hand would")
// stays true rather than aspirational.
//
// fx_sqrt is claimed exact over the whole non-negative int range, so the ends of
// that range are checked explicitly: 2147395600 is 46340^2 and 46340 is the
// largest root an int can hold, so 2147395599 must come back one lower and
// 2147483647 must not come back one higher. Expected values are python3's
// math.isqrt.

t_pow() {
  print("fx_pow(3,5) exp 243 | (2,10) exp 1024 | (2,0) exp 1 | (-2,3) exp -8 = " + fx_pow(3, 5) + " " + fx_pow(2, 10) + " " + fx_pow(2, 0) + " " + fx_pow(0 - 2, 3));
  print("fx_pow(5,-1) exp 1 | (10,9) exp 1000000000 | (2,31) exp -2147483648 wraps = " + fx_pow(5, 0 - 1) + " " + fx_pow(10, 9) + " " + fx_pow(2, 31));
  t_sqrt();
} return void;

t_sqrt() {
  print("fx_sqrt(0,1,2,3,4) exp 0 1 1 1 2 = " + fx_sqrt(0) + " " + fx_sqrt(1) + " " + fx_sqrt(2) + " " + fx_sqrt(3) + " " + fx_sqrt(4));
  print("fx_sqrt(-5,9,10000) exp 0 3 100 = " + fx_sqrt(0 - 5) + " " + fx_sqrt(9) + " " + fx_sqrt(10000));
  t_sqrtbig();
} return void;

t_sqrtbig() {
  print("fx_sqrt(999999) exp 999 | (1000000) exp 1000 = " + fx_sqrt(999999) + " " + fx_sqrt(1000000));
  print("fx_sqrt(2147395599) exp 46339 | (2147395600) exp 46340 | (2147483646) exp 46340 | (2147483647) exp 46340 = " + fx_sqrt(2147395599) + " " + fx_sqrt(2147395600) + " " + fx_sqrt(2147483646) + " " + fx_sqrt(2147483647));
  t_hyp();
} return void;
