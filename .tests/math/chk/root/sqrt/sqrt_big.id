t_sqrt_e(int fx_sqrt_v6, int fx_sqrt_v7) {
  int fx_sqrt_v8 = fx_sqrt(10000);
  print("fx_sqrt(-5,9,10000) exp 0 3 100 = " + fx_sqrt_v6 + " " + fx_sqrt_v7 + " " + fx_sqrt_v8);
  t_sqrtbig();
} return void;

t_sqrtbig() {
  int fx_sqrt_v = fx_sqrt(999999);
  int fx_sqrt_v2 = fx_sqrt(1000000);
  t_sqrtbig_b(fx_sqrt_v, fx_sqrt_v2);
} return void;

t_sqrtbig_b(int fx_sqrt_v, int fx_sqrt_v2) {
  print("fx_sqrt(999999) exp 999 | (1000000) exp 1000 = " + fx_sqrt_v + " " + fx_sqrt_v2);
  int fx_sqrt_v3 = fx_sqrt(2147395599);
  t_sqrtbig_c(fx_sqrt_v3);
} return void;
