// fx_hyp, fx_hyp3 and fx_wroot -- the wide half.
//
// fx_hyp's large cases are the point of it: 46000^2 + 46000^2 is 4.2e9, twice
// the int range, and 65535^2 + 65535^2 is 8.6e9 -- both would wrap to a small or
// negative radicand if the sum were not accumulated in a word. Above 2^31 is the
// case that used to be silently wrong: fx_sqrt cannot start high enough there
// and returns a root far too small with no fault raised, which is why fx_hypfix
// recurses. Expected values are python3's math.isqrt of the exact sum.
//
// The ceiling is the *result*, not the operands: these answer an int, so a
// magnitude of 2^31 or more cannot come back however wide the radicand was.
// fx_wroot(2^62) is exactly 2147483648 and is therefore NOT asserted here -- it
// wraps, and testing it would be testing the wrap rather than the root.

t_hyp() {
  int fx_hyp_v = fx_hyp(3, 4);
  int fx_hyp_v2 = fx_hyp(0, 0);
  t_hyp_b(fx_hyp_v, fx_hyp_v2);
} return void;

t_hyp_b(int fx_hyp_v, int fx_hyp_v2) {
  int fx_hyp_v3 = fx_hyp(1, 1);
  int fx_hyp_v4 = fx_hyp(0 - 3, 0 - 4);
  t_hyp_c(fx_hyp_v, fx_hyp_v2, fx_hyp_v3, fx_hyp_v4);
} return void;

t_hyp_c(int fx_hyp_v, int fx_hyp_v2, int fx_hyp_v3, int fx_hyp_v4) {
  print("fx_hyp(3,4) exp 5 | (0,0) exp 0 | (1,1) exp 1 | (-3,-4) exp 5 = " + fx_hyp_v + " " + fx_hyp_v2 + " " + fx_hyp_v3 + " " + fx_hyp_v4);
  int fx_hyp_v5 = fx_hyp(30000, 40000);
  t_hyp_d(fx_hyp_v5);
} return void;
