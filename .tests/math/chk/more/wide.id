// fx_hyp, fx_hyp3 and fx_wroot -- the wide half.
//
// fx_hyp's large cases are the point of it: 46000^2 + 46000^2 is 4.2e9, twice
// the int range, and 65535^2 + 65535^2 is 8.6e9 -- both would wrap to a small or
// negative radicand if the sum were not accumulated in a word. Above 2^31 is the
// case that used to be silently wrong: fx_sqrt cannot start high enough there
// and returns a root far too small with no fault raised, which is why fx_hypfix
// recurses. Expected values are python3's math.isqrt of the exact sum.
//
// The ceiling is the *result*, not the operands: these answer an int, so a
// magnitude of 2^31 or more cannot come back however wide the radicand was.
// fx_wroot(2^62) is exactly 2147483648 and is therefore NOT asserted here -- it
// wraps, and testing it would be testing the wrap rather than the root.

t_hyp() {
  print("fx_hyp(3,4) exp 5 | (0,0) exp 0 | (1,1) exp 1 | (-3,-4) exp 5 = " + fx_hyp(3, 4) + " " + fx_hyp(0, 0) + " " + fx_hyp(1, 1) + " " + fx_hyp(0 - 3, 0 - 4));
  print("fx_hyp word intermediate (30000,40000) exp 50000 | (46000,46000) exp 65053 | (65535,65535) exp 92680 = " + fx_hyp(30000, 40000) + " " + fx_hyp(46000, 46000) + " " + fx_hyp(65535, 65535));
  t_wide();
} return void;

t_wide() {
  print("fx_hyp(2e6,2e6) exp 2828427 | (1e9,1e9) exp 1414213562 | (1.5e9,1e9) exp 1802775637 | (2e9,0) exp 2000000000 = " + fx_hyp(2000000, 2000000) + " " + fx_hyp(1000000000, 1000000000) + " " + fx_hyp(1500000000, 1000000000) + " " + fx_hyp(2000000000, 0));
  print("fx_hyp3(1,2,2) exp 3 | (3,4,12) exp 13 | (1000,2000,2000) exp 3000 | (2e6,2e6,1e6) exp 3000000 = " + fx_hyp3(1, 2, 2) + " " + fx_hyp3(3, 4, 12) + " " + fx_hyp3(1000, 2000, 2000) + " " + fx_hyp3(2000000, 2000000, 1000000));
  t_wroot();
} return void;

t_wroot() {
  print("fx_wroot(2000000001) exp 44721 | (2147483648) exp 46340 | (1e18) exp 1000000000 | (4e18) exp 2000000000 = " + fx_wroot(2000000001) + " " + fx_wroot(2147483648) + " " + fx_wroot(1000000000000000000) + " " + fx_wroot(4000000000000000000));
  print("fx_sq(46341) exp 2147488281 wide, not wrapped = " + fx_sq(46341));
  t_norm();
} return void;
