t_fxdiv_d(int fx_div_v, int fx_div_v2, int fx_div_v3, int fx_div_v4) {
  print("fx_div(1000,4000,1000) exp 250 | (-1000,4,1000) exp -250000 | word (3000000,7,1000) exp 428571428 | (5,0,1000) exp 0 = " + fx_div_v + " " + fx_div_v2 + " " + fx_div_v3 + " " + fx_div_v4);
  t_fxlerp();
} return void;

t_fxlerp() {
  int fx_lerp_v = fx_lerp(0, 1000, 500);
  int fx_lerp_v2 = fx_lerp(100, 200, 250);
  t_fxlerp_b(fx_lerp_v, fx_lerp_v2);
} return void;

t_fxlerp_b(int fx_lerp_v, int fx_lerp_v2) {
  print("fx_lerp(0,1000,500) exp 500 | (100,200,250) exp 125 = " + fx_lerp_v + " " + fx_lerp_v2);
  int fx_lerp_v3 = fx_lerp(0 - 1000, 1000, 750);
  t_fxlerp_c(fx_lerp_v3);
} return void;
