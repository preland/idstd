// fx_mul / fx_div / fx_lerp / fx_pow. The interesting cases are the ones whose
// product does not fit in 32 bits: 100000 * 100000 is 10^10 and 46341^2 is just
// past 2^31-1, so both would wrap to a negative number without the word
// intermediate. A zero divisor is checked too, because the guard is the only
// thing between a caller's zero scale and a process abort.

t_fxscale() {
  int fx_mul_v = fx_mul(2000, 3000, 1000);
  int fx_mul_v2 = fx_mul(0 - 2000, 3000, 1000);
  t_fxscale_b(fx_mul_v, fx_mul_v2);
} return void;

t_fxscale_b(int fx_mul_v, int fx_mul_v2) {
  print("fx_mul(2000,3000,1000) exp 6000 | (-2000,3000,1000) exp -6000 = " + fx_mul_v + " " + fx_mul_v2);
  int fx_mul_v3 = fx_mul(100000, 100000, 1000);
  t_fxscale_c(fx_mul_v3);
} return void;

t_fxscale_c(int fx_mul_v3) {
  int fx_mul_v4 = fx_mul(46341, 46341, 1000);
  print("fx_mul word intermediate (100000,100000,1000) exp 10000000 | (46341,46341,1000) exp 2147488 = " + fx_mul_v3 + " " + fx_mul_v4);
  t_fxdiv();
} return void;
