// Unit tests for core/math. Every line names the expected value in its own
// label, so the output is self-describing and run.sh can diff the whole thing
// against golden.txt -- a regression is a one-line diff rather than a judgement
// call. Every expected value was computed independently with python3
// (math.isqrt, math.atan2, an FNV-1a model, a Park-Miller model); none of them
// was read off a run of this code.
//
// The checks are one long chain of three-action functions, each ending by
// calling the next, because that is the only way to run more than three of them:
// a block holds three actions and the free return clause.
//
// fx_trig_init and rnd_init run first because an exported global does not exist
// until its declaring function has run, and reading one before that segfaults.
// This project has no import.id: the standard library is resolved implicitly.

main(int argc, string[] argv) {
  fx_trig_init();
  rnd_init(12345);
  t_fxbase();
} return int 0;

t_fxbase() {
  print("fx_abs(-7,7,0) exp 7 7 0 = " + fx_abs(0 - 7) + " " + fx_abs(7) + " " + fx_abs(0));
  print("fx_min(-3,5) exp -3 | fx_max(-3,5) exp 5 = " + fx_min(0 - 3, 5) + " " + fx_max(0 - 3, 5));
  t_fxlim();
} return void;

t_fxlim() {
  print("fx_clamp(5,-5,99 into 0..10) exp 5 0 10 = " + fx_clamp(5, 0, 10) + " " + fx_clamp(0 - 5, 0, 10) + " " + fx_clamp(99, 0, 10));
  print("fx_sign(-9,0,9) exp -1 0 1 = " + fx_sign(0 - 9) + " " + fx_sign(0) + " " + fx_sign(9));
  t_fxscale();
} return void;
