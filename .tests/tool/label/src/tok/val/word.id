// Runs of characters.

// A token that is not bracketed runs to the next whitespace.
lbl_word(string[] toks, string text, int i) {
  int j = lbl_wend(text, i);
  string piece = str_slice(text, i, j - i);
  push(toks, piece);
} return int j;
([], "ab c", 0):(2)
([], "x", 0):(1)

lbl_wend(string text, int i) {
  while (charat(text, i) >= 0 && tl_wsat(text, i) = 0) {
    i = i + 1;
  }
} return int i;
("ab c", 0):(2)
("abc", 1):(3)

// Past a run of ASCII digits starting at i. chr_is_digit_at is idstd's own,
// internal to core/text; a copy here would be the same function twice.
lbl_digits(string tok, int i) {
  while (chr_is_digit_at(tok, i) = 1) {
    i = i + 1;
  }
} return int i;
("12a", 0):(2)
("-5", 1):(2)
("x", 0):(0)
