// Functions missing from the registry, and registry rows for functions that
// are gone.

nm_fmsgs(string[] bad, string reg, string[] srt) {
  int i = 0;
  while (i < len(srt)) {
    nm_fmsg(bad, reg, srt[i]);
    i = i + 1;
  }
} return void;
([], "", ["f\tp"]):(["function 'f' (p) is not in NAMES.md section 1"], "", ["f\tp"])
([], "`f`", ["f\tp"]):([], "`f`", ["f\tp"])

nm_fmsg(string[] bad, string reg, string pr) {
  string fname = nm_pname(pr);
  string path = nm_after(pr);
  if (str_find(reg, "`" + fname + "`") < 0) {
    push(bad, "function '" + fname + "' (" + path + ") is not in NAMES.md section 1");
  }
} return void;
([], "", "g\tq.id"):(["function 'g' (q.id) is not in NAMES.md section 1"], "", "g\tq.id")
([], "`g`", "g\tq.id"):([], "`g`", "g\tq.id")

// The reverse direction: NAMES.md must not promise functions that are gone.
nm_rows(string[] bad, string reg, string[] fns) {
  string[] lines = str_split(reg, "\n");
  int i = 0;
  while (i < len(lines)) {
    nm_row(bad, lines[i], fns);
    i = i + 1;
  }
} return void;
([], "x\n| `f` | `(int) -> int` | pub |\n", []):(["NAMES.md lists 'f', which no longer exists in the library"], "x\n| `f` | `(int) -> int` | pub |\n", [])
([], "| `f` | `(int) -> int` |", ["f"]):([], "| `f` | `(int) -> int` |", ["f"])
