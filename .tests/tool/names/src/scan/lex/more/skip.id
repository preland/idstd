// Characters inside a name, whitespace, and a type's brackets.

nm_inner(string s, int i) {
  int c = charat(s, i);
  int hit = (c >= 97 && c <= 122) || c = 95 || (c >= 48 && c <= 57);
} return int hit;
("a9", 1):(1)
("a(", 1):(0)

nm_skip(string s, int i) {
  while (tl_wsat(s, i) = 1) {
    i = i + 1;
  }
} return int i;
("a  b", 1):(3)
("ab", 1):(1)
("", 0):(0)

nm_brackets(string s, int e) {
  while (str_eqat(s, e, "[]") = 1) {
    e = e + 2;
  }
} return int e;
("int[][] x", 3):(7)
("int x", 3):(3)
