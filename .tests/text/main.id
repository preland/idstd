// Unit tests for core/text. Self-describing lines, diffed against golden.txt.
// No import.id: the standard library is resolved implicitly.
//
// The classifiers are asserted against -1 as well as against real bytes, because
// charat answers -1 past the end of a string and every per-character loop in
// core/text tests the character before it tests the bound. A chr_is_space that
// answered 1 for -1 would make str_trim walk off the end.

main(int argc, string[] argv) {
  t_chr();
} return int 0;

t_chr() {
  print("chr_is_digit('0','9','a',-1) exp 1 1 0 0 = " + chr_is_digit(48) + " " + chr_is_digit(57) + " " + chr_is_digit(97) + " " + chr_is_digit(0 - 1));
  print("chr_is_alpha('A','z','0',-1) exp 1 1 0 0 | chr_is_alnum('0','_') exp 1 0 = " + chr_is_alpha(65) + " " + chr_is_alpha(122) + " " + chr_is_alpha(48) + " " + chr_is_alpha(0 - 1) + " " + chr_is_alnum(48) + " " + chr_is_alnum(95));
  t_case();
} return void;

t_case() {
  print("chr_is_space(' ',tab,nl,cr,'x',-1) exp 1 1 1 1 0 0 = " + chr_is_space(32) + " " + chr_is_space(9) + " " + chr_is_space(10) + " " + chr_is_space(13) + " " + chr_is_space(120) + " " + chr_is_space(0 - 1));
  print("chr_upper('a','A','9') exp 65 65 57 | chr_lower('A','a','9') exp 97 97 57 | chr_hex(0,10,15) exp 48 97 102 = " + chr_upper(97) + " " + chr_upper(65) + " " + chr_upper(57) + " " + chr_lower(65) + " " + chr_lower(97) + " " + chr_lower(57) + " " + chr_hex(0) + " " + chr_hex(10) + " " + chr_hex(15));
  t_slice();
} return void;
