// Matching, searching and ordering.
//
// The empty needle is the case that decides whether str_find and str_starts
// agree with each other: "" occurs at index 0 of everything, including "", and
// str_find_end exists to keep that true at the end of the string as well.
//
// str_cmp's expected values are python3's `(a > b) - (a < b)` on the same pairs.
// 'Z' before 'a' is ASCII order and not a collation, which is asserted so that
// nobody "fixes" it later without noticing they changed a contract.

t_eq() {
  print("str_eqat('hello',2,'ll') exp 1 | (,0,'he') exp 1 | (,0,'x') exp 0 | (,0,'') exp 1 = " + str_eqat("hello", 2, "ll") + " " + str_eqat("hello", 0, "he") + " " + str_eqat("hello", 0, "x") + " " + str_eqat("hello", 0, ""));
  print("str_starts('hello','he','x','') exp 1 0 1 | str_ends('hello','lo','x') exp 1 0 | str_ends('lo','hello') exp 0 = " + str_starts("hello", "he") + " " + str_starts("hello", "x") + " " + str_starts("hello", "") + " " + str_ends("hello", "lo") + " " + str_ends("hello", "x") + " " + str_ends("lo", "hello"));
  t_find();
} return void;

t_find() {
  print("str_find('hello','ll') exp 2 | ('hello','z') exp -1 | ('hello','') exp 0 | ('','') exp 0 = " + str_find("hello", "ll") + " " + str_find("hello", "z") + " " + str_find("hello", "") + " " + str_find("", ""));
  print("str_findat('abab','ab',0) exp 0 | (,'ab',1) exp 2 | (,'ab',3) exp -1 | ('abc','abcd') exp -1 = " + str_findat("abab", "ab", 0) + " " + str_findat("abab", "ab", 1) + " " + str_findat("abab", "ab", 3) + " " + str_find("abc", "abcd"));
  t_cmp();
} return void;

t_cmp() {
  print("str_cmp abc/abd exp -1 | abc/abc exp 0 | abcd/abc exp 1 | ''/a exp -1 = " + str_cmp("abc", "abd") + " " + str_cmp("abc", "abc") + " " + str_cmp("abcd", "abc") + " " + str_cmp("", "a"));
  print("str_cmp Z/a exp -1 ASCII order | apple/apricot exp -1 | ''/'' exp 0 = " + str_cmp("Z", "a") + " " + str_cmp("apple", "apricot") + " " + str_cmp("", ""));
  t_split();
} return void;
