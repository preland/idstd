t_float_f(float str_to_float_v5, float str_to_float_v6, float str_to_float_v7, float str_to_float_v8, float str_to_float_v9) {
  print("str_to_float('','abc','0.5','-0.5','1.5xyz') exp 0 0 0.5 -0.5 1.5 = " + str_to_float_v5 + " " + str_to_float_v6 + " " + str_to_float_v7 + " " + str_to_float_v8 + " " + str_to_float_v9);
  float str_to_float_v10 = str_to_float("  -2.5");
  t_float_g(str_to_float_v10);
} return void;

t_float_g(float str_to_float_v10) {
  float str_to_float_v11 = str_to_float("3.");
  print("str_to_float(' -2.5') exp -2.5 leading space | ('3.') exp 3 no digits after point = " + str_to_float_v10 + " " + str_to_float_v11);
} return void;
