// Unit tests for core/data. Self-describing lines, diffed against golden.txt.
// No import.id: the standard library is resolved implicitly.
//
// Nothing in core/data holds exported state, so there is no init chain here --
// which is itself worth asserting by omission.

main(int argc, string[] argv) {
  t_lset();
} return int 0;

t_lset() {
  int[] xs = [10, 20, 30];
  lset(xs, 1, 99);
  t_lset2(xs);
} return void;

t_lset2(int[] xs) {
  print("lset/lget exp 10 99 30 = " + lget(xs, 0) + " " + lget(xs, 1) + " " + lget(xs, 2));
  print("lst_pick(-1,3,1) exp 3 | (5,7,1) exp 5 keeps first | (-1,7,0) exp -1 = " + lst_pick(0 - 1, 3, 1) + " " + lst_pick(5, 7, 1) + " " + lst_pick(0 - 1, 7, 0));
  t_grow();
} return void;
