// Searching and reducing.
//
// lst_index_of must answer the *first* index, not the last, which is the whole
// content of lst_pick's `at < 0` test -- so the list has a repeated element and
// the assertion is 1, not 4.
//
// lst_sum's expected value is the hand sum of the list: 5+3+9+1+3 = 21.

t_find() {
  int[] xs = [5, 3, 9, 1, 3];
  int lst_index_of_v = lst_index_of(xs, 3);
  t_find_b(xs, lst_index_of_v);
} return void;

t_find_b(int[] xs, int lst_index_of_v) {
  int lst_index_of_v2 = lst_index_of(xs, 9);
  int lst_index_of_v3 = lst_index_of(xs, 7);
  t_find_c(xs, lst_index_of_v, lst_index_of_v2, lst_index_of_v3);
} return void;

t_find_c(int[] xs, int lst_index_of_v, int lst_index_of_v2, int lst_index_of_v3) {
  print("lst_index_of(3) exp 1 first not last | (9) exp 2 | (7) exp -1 = " + lst_index_of_v + " " + lst_index_of_v2 + " " + lst_index_of_v3);
  t_find2(xs);
} return void;
