// The empty-list edges, and the two setters that are not lset.
//
// t_empty2 runs early in the chain (grow.id hands to it) but lives here because
// grow.id is full at three functions. The chain's order is the order of the
// output, not the order of the files.

t_empty2(int[] xs) {
  lst_reverse(xs);
  print("empty list: len exp 0 | lst_sum exp 0 | lst_index_of exp -1 | lst_find exp 0 = " + len(xs) + " " + lst_sum(xs) + " " + lst_index_of(xs, 1) + " " + lst_find(xs, 1));
  t_find();
} return void;

// sset writes through a list of strings and lset2 through a list of lists --
// the two things lset cannot do, because `id` has no generics and a setter's
// element type is part of its signature.
t_sset() {
  string[] strs = ["a", "b"];
  sset(strs, 0, "z");
  t_sset2(strs);
} return void;

t_sset2(string[] strs) {
  int[][] grid = [[1, 2], [3, 4]];
  lset2(grid, 0, [9, 8]);
  print("sset exp z b = " + strs[0] + " " + strs[1] + " | lset2 exp 9 8 3 4 = " + grid[0][0] + " " + grid[0][1] + " " + grid[1][0] + " " + grid[1][1]);
} return void;
