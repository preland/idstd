// buf_cmp's three answers, and buf_zero.
//
// "AAAA" against "BAAA" is -1 because 'A' (65) is below 'B' (66) and the first
// differing byte decides; the same pair the other way round is 1. A zeroed range
// compared with itself is 0, which is also the check that buf_zero ran at all --
// alloc already hands back zeroed memory, so the range is filled first and then
// zeroed, or the assertion would pass without buf_zero existing.

t_bufcmp(word ad) {
  string str_of_mem_v = str_of_mem(ad, 4);
  string str_of_mem_v2 = str_of_mem(ad + 8, 4);
  t_bufcmp_b(ad, str_of_mem_v, str_of_mem_v2);
} return void;

t_bufcmp_b(word ad, string str_of_mem_v, string str_of_mem_v2) {
  print("buf_fill/buf_copy exp [AAAA] [BAAA] = [" + str_of_mem_v + "] [" + str_of_mem_v2 + "]");
  int buf_cmp_v = buf_cmp(ad, ad + 8, 4);
  t_bufcmp_c(ad, buf_cmp_v);
} return void;

t_bufcmp_c(word ad, int buf_cmp_v) {
  int buf_cmp_v2 = buf_cmp(ad + 8, ad, 4);
  int buf_cmp_v3 = buf_cmp(ad, ad, 4);
  t_bufcmp_d(ad, buf_cmp_v, buf_cmp_v2, buf_cmp_v3);
} return void;
